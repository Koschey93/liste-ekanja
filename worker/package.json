    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250604.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.20.0"
